---
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  hicpp-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -hicpp-avoid-magic-numbers,
  -hicpp-no-array-decay,
  -hicpp-signed-bitwise,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-named-parameter,
  -portability-simd-intrinsics

CheckOptions:
  - key: readability-identifier-length.MinimumVariableNameLength
    value: '2'
  - key: readability-identifier-length.IgnoredVariableNames
    value: 'i,j,k,x,y,z,dx,dy,ex,fx,gx,hx,ix,jx,kx,lx,mx,nx,ox,px,qx,rx,sx,tx,ux,vx,wx,xx,yx,zx'
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  - key: cppcoreguidelines-pro-type-member-init.IgnoreArrays
    value: 'true'
  - key: bugprone-exception-escape.WarnNoexceptFunctionsOnly
    value: 'true'
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'std::string_view;std::span;std::optional;std::variant;std::any;std::function;std::unique_ptr;std::shared_ptr;std::weak_ptr'

WarningsAsErrors: ''
HeaderFilterRegex: '^src/'
FormatStyle: file
...