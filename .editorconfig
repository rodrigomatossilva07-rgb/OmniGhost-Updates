# EditorConfig for OmniGhost
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,inl,c,cc,cxx}]
indent_size = 4
tab_width = 4

[*.{json,yml,yaml,jsonc}]
indent_size = 2
tab_width = 2

[*.{md,txt}]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.py]
indent_size = 4
tab_width = 4

[Makefile]
indent_style = tab

# CMake files
[CMakeLists.txt]
indent_size = 2
tab_width = 2

[*.cmake]
indent_size = 2
tab_width = 2

# vcpkg files
[vcpkg.json]
indent_size = 2

# GitHub Actions
[.github/workflows/*.yml]
indent_size = 2

# Visual Studio specific
[*.{vcxproj,vcxproj.filters,props,targets,vsprops}]
indent_size = 2