# Auto detect text files and perform LF normalization
* text=auto

# Windows batch/scripts - keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source files - LF
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.inl text eol=lf
*.rc text eol=lf
*.rc2 text eol=lf
*.manifest text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf

# Visual Studio project files - CRLF
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.slnx text eol=crlf