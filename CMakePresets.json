{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_RC_COMPILER": "rc.exe",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "windows-debug",
      "inherits": ["windows-base"],
      "displayName": "Windows Debug (x64)",
      "description": "Debug build with full symbols and assertions",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": ["windows-base"],
      "displayName": "Windows Release (x64)",
      "description": "Optimized Release build with string protection",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-publish-cfg",
      "inherits": ["windows-base"],
      "displayName": "Windows Publish (x64)",
      "description": "Production Publish build - single EXE, reproducibility checks",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Publish"
      }
    },
    {
      "name": "windows-dev",
      "inherits": ["windows-base"],
      "displayName": "Windows Development (x64)",
      "description": "Development build for admins - includes DEV config channel, debug symbols, assertions",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Development"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "build-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "build-publish",
      "configurePreset": "windows-publish-cfg",
      "configuration": "Publish",
      "jobs": 8
    },
    {
      "name": "build-dev",
      "configurePreset": "windows-dev",
      "configuration": "Development",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "test-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "test-dev",
      "configurePreset": "windows-dev",
      "configuration": "Development",
      "output": {"outputOnFailure": true}
    }
  ],
  "workflowPresets": [
    {
      "name": "dev-loop",
      "steps": [
        { "type": "configure", "name": "windows-debug" },
        { "type": "build", "name": "build-debug" },
        { "type": "test", "name": "test-debug" }
      ]
    },
    {
      "name": "ci-pipeline",
      "steps": [
        { "type": "configure", "name": "windows-release" },
        { "type": "build", "name": "build-release" },
        { "type": "test", "name": "test-release" }
      ]
    }
  ],
  "vendor": {
    "omnighost.dev": {
      "defaultConfigurePreset": "windows-release",
      "defaultBuildPreset": "build-release",
      "defaultTestPreset": "test-release",
      "workflows": {
        "ci": "ci-pipeline",
        "dev": "dev-loop",
        "publish": "publish-pipeline",
        "dev-release": "dev-pipeline"
      }
    }
  }
}
