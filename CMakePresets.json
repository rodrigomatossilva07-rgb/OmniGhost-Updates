{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_RC_COMPILER": "rc.exe",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      },
      "environment": {
        "VCPKG_ROOT": "$env{VCPKG_ROOT}",
        "VCPKG_DEFAULT_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "windows-debug",
      "inherits": ["windows-base"],
      "displayName": "Windows Debug (x64)",
      "description": "Debug build with full symbols and assertions",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": ["windows-base"],
      "displayName": "Windows Release (x64)",
      "description": "Optimized Release build with string protection",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-publish",
      "inherits": ["windows-base"],
      "displayName": "Windows Publish (x64)",
      "description": "Production Publish build - single EXE, reproducibility checks",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Publish"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "build-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "build-publish",
      "configurePreset": "windows-publish",
      "configuration": "Publish",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "test-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {"outputOnFailure": true}
    }
  ],
  "workflowPresets": [
    {
      "name": "dev-loop",
      "steps": [
        { "type": "configure", "name": "windows-debug" },
        { "type": "build", "name": "build-debug" },
        { "type": "test", "name": "test-debug" }
      ]
    },
    {
      "name": "ci-pipeline",
      "steps": [
        { "type": "configure", "name": "windows-release" },
        { "type": "build", "name": "build-release" },
        { "type": "test", "name": "test-release" }
      ]
    },
    {
      "name": "publish-pipeline",
      "steps": [
        { "type": "configure", "name": "windows-publish" },
        { "type": "build", "name": "build-publish" },
        { "type": "test", "name": "test-release" }
      ]
    },
    {
      "name": "ci-pipeline",
      "steps": [
        { "type": "configure", "name": "windows-release" },
        { "type": "build", "name": "build-release" },
        { "type": "test", "name": "test-release" }
      ]
    },
    {
      "name": "publish-pipeline",
      "steps": [
        { "type": "configure", "name": "windows-publish" },
        { "type": "build", "name": "build-publish" },
        { "type": "test", "name": "test-release" }
      ]
    }
  ],
  "vendor": {
    "omnighost.dev": {
      "defaultConfigurePreset": "windows-release",
      "defaultBuildPreset": "build-release",
      "defaultTestPreset": "test-release",
      "workflows": {
        "ci": "ci-pipeline",
        "dev": "dev-loop",
        "publish": "publish-pipeline"
      }
    }
  }
}