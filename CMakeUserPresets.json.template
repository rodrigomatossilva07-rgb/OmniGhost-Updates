{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "local-release",
      "inherits": "release-x64",
      "displayName": "Local Release (Custom)",
      "description": "Local development release build - customize paths here",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "C:/OmniGhost/Install",
        "VCPKG_ROOT": "C:/vcpkg"
      },
      "environment": {
        "VCPKG_ROOT": "C:/vcpkg"
      }
    },
    {
      "name": "local-publish",
      "inherits": "publish-x64",
      "displayName": "Local Publish (Custom)",
      "description": "Local publish build - customize signing, etc.",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "C:/OmniGhost/Publish",
        "VCPKG_ROOT": "C:/vcpkg",
        "OMNIGHOST_SIGN_ENABLED": "ON",
        "OMNIGHOST_CERT_THUMBPRINT": "YOUR_CERT_THUMBPRINT_HERE",
        "OMNIGHOST_CERT_PASSWORD": "YOUR_CERT_PASSWORD_HERE"
      },
      "environment": {
        "VCPKG_ROOT": "C:/vcpkg"
      }
    },
    {
      "name": "ci-release",
      "inherits": "release-x64",
      "displayName": "CI Release",
      "description": "CI/CD release build",
      "cacheVariables": {
        "VCPKG_ROOT": "${{ runner.temp }}/vcpkg",
        "CMAKE_INSTALL_PREFIX": "${{ runner.temp }}/install"
      },
      "environment": {
        "VCPKG_ROOT": "${{ runner.temp }}/vcpkg"
      }
    },
    {
      "name": "ci-publish",
      "inherits": "publish-x64",
      "displayName": "CI Publish",
      "description": "CI/CD publish build with signing",
      "cacheVariables": {
        "VCPKG_ROOT": "${{ runner.temp }}/vcpkg",
        "CMAKE_INSTALL_PREFIX": "${{ runner.temp }}/install",
        "OMNIGHOST_SIGN_ENABLED": "ON",
        "OMNIGHOST_CERT_THUMBPRINT": "${{ secrets.SIGN_CERT_THUMBPRINT }}",
        "OMNIGHOST_CERT_PASSWORD": "${{ secrets.SIGN_CERT_PASSWORD }}"
      },
      "environment": {
        "VCPKG_ROOT": "${{ runner.temp }}/vcpkg"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local-release",
      "configurePreset": "local-release",
      "configuration": "Release",
      "jobs": 16,
      "targets": ["OmniGhost"]
    },
    {
      "name": "local-publish",
      "configurePreset": "local-publish",
      "configuration": "Publish",
      "jobs": 16,
      "targets": ["OmniGhost"]
    },
    {
      "name": "local-test",
      "configurePreset": "local-release",
      "configuration": "Release",
      "targets": ["OmniGhost_Tests"]
    }
  ]
}