    </Exec>
    <Error Condition="'$(OmniGhostProjectValidationExitCode)'!='0'" Code="OGENG001" Text="Falha na validação de engenharia/dependências do projeto. Consulta a janela Saída e procura a primeira linha [FAIL] para ver a causa exata."/>
  </Target>
  <Target Name="ValidateOmniGhostPublishVersion" BeforeTargets="ValidateOmniGhostProjectLayout" Condition="'$(Configuration)'=='Publish' And '$(DesignTimeBuild)'!='true' And '$(OmniGhostSkipRemotePublish)'!='true' And '$(OmniGhostSkipVersionAdvance)'!='true'">
    <Message Importance="High" Text="[OmniGhost 02/10] Versão, Git e política de publicação"/>
    <Exec Command="&quot;$(MSBuildProjectDirectory)\tools\Run-OmniGhostPowerShell.cmd&quot; prepare-publish-version &quot;$(MSBuildProjectDirectory)&quot;" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="OmniGhostPreparePublishVersionExitCode"/>
    </Exec>
    <Error Condition="'$(OmniGhostPreparePublishVersionExitCode)'!='0'" Code="OGVER002" Text="Pré-validação Publish falhou. Consulta todas as linhas [ERROR] no log de Release validation."/>
  </Target>
  <Target Name="EnsureOmniGhostMetadata" BeforeTargets="PrepareForBuild">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\tools\Run-OmniGhostPowerShell.cmd&quot; ensure-metadata &quot;$(MSBuildProjectDirectory)&quot;" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="OmniGhostMetadataExitCode"/>
    </Exec>
    <Error Condition="'$(OmniGhostMetadataExitCode)'!='0'" Code="OGVER001" Text="Falha ao validar os metadados e a versão do OmniGhost."/>
  </Target>
  <Target Name="ValidateOmniGhostDistributionBuild" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)'!='PrivateStatic'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\tools\Run-OmniGhostPowerShell.cmd&quot; validate-distribution &quot;$(MSBuildProjectDirectory)&quot; &quot;$(Configuration)&quot;" StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" IgnoreExitCode="true">
