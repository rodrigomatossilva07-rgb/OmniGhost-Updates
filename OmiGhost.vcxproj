    </Exec>
    <Error Condition="'$(OmniGhostCloudflaredExitCode)'!='0'" Code="OGCFD001" Text="Nao foi possivel garantir o cloudflared oficial assinado pela Cloudflare. A build foi interrompida para nao embutir um binario nao verificado. Corre tools\Update-Cloudflared.ps1 -Latest e consulta logs\cloudflared-update-*.log, ou define OmniGhostUpdateCloudflared=false para uma build hermetica."/>
