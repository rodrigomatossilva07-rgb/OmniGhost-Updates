<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir Condition="'$(Configuration)'=='Tester'">$(ProjectDir)build\Tester\</OutDir>
    <OutDir Condition="'$(Configuration)'=='Publish'">$(ProjectDir)build\Publish\</OutDir>
    <OutDir Condition="'$(OutDir)'==''">$(ProjectDir)build\</OutDir>
    <IntDir>$(ProjectDir).cache\intermediate\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>OmniGhost</TargetName>
    <!-- app.rc embeds resources/app.manifest as RT_MANIFEST ID 1. Disable the
         linker's implicit UAC manifest to prevent a duplicate resource. -->
    <GenerateManifest>false</GenerateManifest>
    <!-- OmniGhost does not rely on MemProcFS InfoDB in its normal runtime.
         Keep the upstream feature disabled unless a developer explicitly opts in. -->
    <OmniGhostDisableVmmInfoDb Condition="'$(OmniGhostDisableVmmInfoDb)'==''">true</OmniGhostDisableVmmInfoDb>
  </PropertyGroup>
<ItemDefinitionGroup>
  <ClCompile>
        <WarningLevel>Level4</WarningLevel>
        <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
        <SDLCheck>true</SDLCheck>
        <ConformanceMode>true</ConformanceMode>
        <LanguageStandard>stdcpp20</LanguageStandard>
        <MultiProcessorCompilation>true</MultiProcessorCompilation>
        <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        <PreprocessorDefinitions Condition="'$(OmniGhostMockHardware)'=='true'">OMNIGHOST_MOCK_HARDWARE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        <PreprocessorDefinitions Condition="'$(OmniGhostDisableVmmInfoDb)'=='true'">OMNIGHOST_DISABLE_VMM_INFODB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        <PreprocessorDefinitions Condition="'$(OmniGhostDisableVmmSymbols)'=='true'">OMNIGHOST_DISABLE_VMM_SYMBOLS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        <PreprocessorDefinitions Condition="'$(OmniGhostReadOnlyMode)'=='true'">OMNIGHOST_READONLY_MODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)src;$(ProjectDir)Fivem;$(ProjectDir)Cs2;$(ProjectDir)Rust;$(ProjectDir)Warzone;$(ProjectDir)Valorant;$(ProjectDir)ImGui;$(ProjectDir)DMALibrary;$(ProjectDir)third_party\dma_stack\include;$(ProjectDir)Utils;$(ProjectDir)resources;$(ProjectDir).cache\generated\$(Configuration)\$(Platform);$(ProjectDir).cache\generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
        <BufferSecurityCheck>true</BufferSecurityCheck>
        <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
        <Optimization>MaxSpeed</Optimization>
        <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
        <InlineFunctionExpansion>OnlyExplicitInline</InlineFunctionExpansion>
        <OmitFramePointers>true</OmitFramePointers>
        <ControlFlowGuard>true</ControlFlowGuard>
        <CETCompat>true</CETCompat>
        <AdditionalOptions>/utf-8 /permissive- /Zc:__cplusplus /Zc:preprocessor /Zc:inline /Zc:externConstexpr /external:I"$(ProjectDir)third_party\dma_stack\include" /guard:cf /guard:ehcont %(AdditionalOptions)</AdditionalOptions>
        <TreatWarningAsError Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='Publish' Or '$(OmniGhostNewWarningsAsErrors)'=='true'">true</TreatWarningAsError>
        <WarningBaselineFile>$(ProjectDir).cache\warnings\baseline.txt</WarningBaselineFile>
      </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir).cache\generated\$(Configuration)\$(Platform);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ProgramDatabaseFile>$(ProjectDir).cache\symbols\$(Configuration)\$(TargetName).pdb</ProgramDatabaseFile>
      <AdditionalDependencies>delayimp.lib;leechcore.lib;vmm.lib;d3d11.lib;dxgi.lib;d3dcompiler.lib;dwmapi.lib;user32.lib;gdi32.lib;imm32.lib;setupapi.lib;ws2_32.lib;windowscodecs.lib;ole32.lib;shell32.lib;winhttp.lib;wininet.lib;bcrypt.lib;wintrust.lib;crypt32.lib;shlwapi.lib;version.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>leechcore.dll;vmm.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <AdditionalLibraryDirectories>$(ProjectDir)third_party\dma_stack\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <SafeSEH>false</SafeSEH>
      <AddressSpaceLayoutRandomization>true</AddressSpaceLayoutRandomization>
      <LargeAddressAware>true</LargeAddressAware>
    </Link>
  </ItemDefinitionGroup>
</Project>