<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <HighEntropyVA>true</HighEntropyVA>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <GenerateMapFile>true</GenerateMapFile>
      <MapExports>true</MapExports>
      <AdditionalOptions>/CETCOMPAT /Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='Publish'">
    <ClCompile>
      <!-- Keep the application and its supported dependencies on the MSVC
           dynamic runtime.  The supplied KeyAuth archive contains legacy
           mixed-runtime directives, which are explicitly normalised below.
           The supported Microsoft VC runtime is supplied by Windows/VC Redist. -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>OMNIGHOST_KEYAUTH_ENABLED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)keyauth\x64;$(ProjectDir)keyauth\x64\lib;$(ProjectDir)keyauth\x64\lib\libsodium;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- library_x64.lib from the supplied KeyAuth SDK contains legacy
           /DEFAULTLIB:LIBCMT directives despite this application and its
           supported dependencies using /MD.  Prefer the project's single
           dynamic CRT instead of allowing both runtimes into the process. -->
      <IgnoreSpecificDefaultLibraries>LIBCMT;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
      <!-- KeyAuth's prebuilt static archive was shipped without its private
           libsodium PDB. Keep OmniGhost's own PDB generation intact while
           suppressing only that third-party debug-symbol diagnostic. -->
      <AdditionalOptions>/IGNORE:4099 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalDependencies>library_x64.lib;libcurl.lib;zlib.lib;libsodium.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(ProjectDir)keyauth\x64;$(ProjectDir)keyauth\x64\lib\curl;$(ProjectDir)keyauth\x64\lib\libsodium;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
