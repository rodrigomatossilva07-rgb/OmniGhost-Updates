<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>OMNIGHOST_TESTER_BUILD=1;OMNIGHOST_REQUIRE_LOCAL_LICENSE=1;OMNIGHOST_SKIP_KEYAUTH=1;OMNIGHOST_DEV_EXTERNAL_OFFSETS=1;OMNIGHOST_DEV_EXTERNAL_RESOURCES=1;OMNIGHOST_VERBOSE_OFFSET_DIAGNOSTICS=1;OMNIGHOST_VERBOSE_RESOURCE_DIAGNOSTICS=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>OMNIGHOST_TESTER_BUILD=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <!-- Incremental is a LinkIncremental value, not a valid LTCG mode in
           current MSVC toolsets. Keep Tester fast without passing an invalid
           value to link.exe. -->
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
      <LinkIncremental>true</LinkIncremental>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(EnableAddressSanitizer)'=='true'">
    <ClCompile>
      <EnableAddressSanitizer>true</EnableAddressSanitizer>
      <AdditionalOptions>/fsanitize=address /fsanitize=undefined %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/fsanitize=address /fsanitize=undefined %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
