<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup><ClCompile><Optimization>MaxSpeed</Optimization><FunctionLevelLinking>true</FunctionLevelLinking><IntrinsicFunctions>true</IntrinsicFunctions><ControlFlowGuard>Guard</ControlFlowGuard><PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile><Link><EnableCOMDATFolding>true</EnableCOMDATFolding><OptimizeReferences>true</OptimizeReferences><ControlFlowGuard>Guard</ControlFlowGuard><DataExecutionPrevention>true</DataExecutionPrevention><RandomizedBaseAddress>true</RandomizedBaseAddress><HighEntropyVA>true</HighEntropyVA><LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration><AdditionalOptions>/CETCOMPAT /Brepro %(AdditionalOptions)</AdditionalOptions></Link></ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='Publish'">
    <ClCompile><RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary><PreprocessorDefinitions>OMNIGHOST_KEYAUTH_ENABLED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions><AdditionalIncludeDirectories>$(ProjectDir)src\project\third_party\keyauth\x64;$(ProjectDir)src\project\third_party\keyauth\x64\lib;$(ProjectDir)src\project\third_party\keyauth\x64\lib\libsodium;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile>
    <Link><IgnoreSpecificDefaultLibraries>LIBCMT;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries><AdditionalOptions>/IGNORE:4099 %(AdditionalOptions)</AdditionalOptions><AdditionalDependencies>library_x64.lib;libcurl.lib;zlib.lib;libsodium.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies><AdditionalLibraryDirectories>$(ProjectDir)src\project\third_party\keyauth\x64;$(ProjectDir)src\project\third_party\keyauth\x64\lib\curl;$(ProjectDir)src\project\third_party\keyauth\x64\lib\libsodium;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories></Link>
  </ItemDefinitionGroup>
</Project>
