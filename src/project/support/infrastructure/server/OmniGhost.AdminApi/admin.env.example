# Copy these values into the host secret manager. Never commit the real values.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
OMNIGHOST_ADMIN_KEYAUTH_SELLER_KEY=replace-with-server-only-seller-key
OMNIGHOST_ADMIN_API_KEY_HASHES=admin=replace-with-sha256-from-New-AdminApiKey
OMNIGHOST_ADMIN_TRUST_FORWARDED_HTTPS=false

# Optional. The service rejects any host other than keyauth.win.
OMNIGHOST_ADMIN_KEYAUTH_ENDPOINT=https://keyauth.win/api/seller/
