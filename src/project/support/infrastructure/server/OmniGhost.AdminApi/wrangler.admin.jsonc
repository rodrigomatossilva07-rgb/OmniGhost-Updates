{
  "name": "omnighost-admin-api",
  "main": "./cloudflare-admin.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "containers": [{
    "class_name": "AdminContainer",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./Dockerfile.cloudflare" } }
  }],
  "durable_objects": { "bindings": [{ "name": "ADMIN_CONTAINER", "class_name": "AdminContainer" }] },
  "exports": { "AdminContainer": { "type": "durable-object", "storage": "sqlite" } }
}
